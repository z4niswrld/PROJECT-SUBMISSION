public interface IEmergencyIncident
{
//Incident information
string IncidentID {get;set;}
}
string Location {get;set;
}
string EmergencyType {get;set;
}
int PeopleAffected {get;set;
}
int Severity {get;set;
}
int ResponseTime {get; set;
}
int AssignedUnits {get;set;
}

//Required resources
int RequiredUnits {get;}

//Incident analysis results
double PriorityScore {get;
}
string ResponseLevel {get;
}
string ResourceStatus {get;
}
string AdditionalUnitsRequired {get;
}

//Methods
void CalculatePriorityScore();
void DetermineResponseLevel();
void CheckResources();

void UpdateAssignedUnits(int newUnits);
}

using System

public class MedicalIncident : IEmergencyIncident
{
//PRIVATE FIELDS
private string incicdentID;
private string location;
private int peopleAffected;
private int severity;
private int responseTime;
private int assignedUnits;

private double priorityScore;
private string responseLevel;
private string resourceStatus;
private int additionalUnitRequired;

//PUBLIC PROPERTIES
public string IncidentID
{
get {return incidentID;}
set {incidentID = value}
}

public string Location
{
get {return location;}
set {location value;}
}

public string EmergencyType
{
get {return "Medical";}
}

public int PepleAffected
{
get {return peopleAffected;}
set {peopleAffected = value;}
}

public int Severity
{
get {return severity;}
set {severity = value;}

}

public int ResponseTime
{
get {return responseTime;}
set {responseTime = value;}

}

public int AssignedUnits
{
get {return assignedUnits;}
set {assignUnits = value;}

}
public int RequiredUnits
{
get { return 2;}

}
public double priorityScore
{
get {return priorityScore;}

}
public string ResponseLevel
{
get {return responseLevel;}

}
public string ResourceStats
{
get {return resourceStatus;}

}
public int AdditionUnitsRequired
{
get {return additionalUnitsRequired;}

}

//CONSTRUCTOR

public MedicalIncident(string id, string location,
int people, int sev, int time, int units)
{
incidentID = id;
location = location;
peopleAffected = people;
severity = sev;
responseTime = time;
assignedUnits = units;

CalculatePriorityScore();
DetermineResponseLevel();
CheckResources();

}
//CALCULATE PRIORITY SCORE
public void CalculatePriorityScore()
{
priorityScore = (severity * 20)
               +(peopleAffected * 2)
               -(responseTime/ 5.0);

if (priorScore < 0)
{
priorityScorw = 0;
}
}

//DETERMINE RESPONSE LEVEL
public void DetermineResponseLevel1()
{
if (priorityScore >= 70)
{
responseLevel1 = "Critical";
}
else if (priorityScore >= 40)
{
responseLevel  = "Urgent";
}
else
{
responseLevel "Routine";
}
}

//CHECK RESOURCES
public void CheckResources()
{
if (assignedUnits >= RequiredUnits)
{
resourceStatus "Sufficient Resources";
additionalUnitsRequired 0;
}
else
{
resourceStatus = "Insufficient Resources";
additionalUnitsRequired = RequiredUnits - assignedUnits;
}
}
//UPDATE ASSIGNED UNITS
public void UpdateAssignedUnits(int newUnits)
{
if (newUnits >= 0)
{
assignedUnits = newUnits;
CheckResources();
}
}
}
