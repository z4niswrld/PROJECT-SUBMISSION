using System
using System.Collections;

public class IncidentManager
{
//ARRAYLIST TO STORE INCIDENTS
private ArrayList incidents;

//CONSTRUCTOR
public IncidentManager()
{
incidents = new ArrayList();
}

ADD NEW INCIDENT
public bool AddIncidnet(IEmergencyIncident incident)
{
if (incident == null)
{
return false;
}

//CHECK IF INCIDENT ID ALREADY EXISTS
for (int i = 0; i < incidents.Count; i++)
{
IEmergencyIncident existing =
(IEmergencyIncident)incident[i];

if (existing.IncidentID == incident.IncidentID)
{
return false;
}
}
incidents.Add(incident);
return true;
}

//FIND AN INCIDENT USING ITS ID
public IEmergencyIncident FindIncident(string id)
{
IEmergencyIncident incident =
(IEmergencyIncident)incidents[i];

if (incident.IncidentID == id)
{
return incident;
}
}
return null;
}
//UPDATE ASSIGNED UNITS
public bool UpdateIncidentUnits(string id, int newUnits)
{
if (newUnits < 0)
{
return false;
}
IEmeeergencyIncident incident = FindIncident(id);
if (incident != null)
{
incident.UpdateAssignedUnits(newUnits);
return true;
}
return false;
}
//GET TOTAL NUMBER OF INCIDENTS
public int GetTotalIncidents()
{
return incidents.Count;
}

//GET AN INCIDENT USING POSTION
public IEmergencyIncident GetIncidentAt(int index)
(
if (index >= 0 && index < incidents.Count)
{
return(IEmergencyIncident)incidents[index];
}
return null;
}

//CALCULATE AVERAGE PRIORITY
public double GetAveragePriority()
{
if (incidents.Count == 0)
{
return 0;
}

double total = 0;
for (int i = 0; i < incidents.count; i++)
{
(IEmergencyIncident)incidents[i];

total += incident.PriorityScore;
}

return total / incidents.Count;
}

//GET HIGHEST PRIORITY
public double GetHighestPriority()
{
if (incidents.Count == 0)
{
return 0;
}

double highest = 0;

for (int i = 0; i < incidents.Count; i++)
{
IEmergencyIncident)incidents[i];

if (incident.PriorityScore > highest)
{
highest = incident.PriorityScore;
}
}
return highest;
}

//GET LOWEST PRIORITY
public double GetLowestPriority()
{
if (incidents.Count == 0)
{
return 0;
}

IEmergencyIncident first =
(IEmergencyIncident)incidents[0];

double lowest = first.PriorityScore;

for(int i = 1; i < incident.Count; i++)
{
IEmergencyIncident incident =
(IEmergencyIncident)incidents[i];

if(incident.PriorityScore < lowest)
{
lowest = incidentPriorityScore;
}
}
return lowest;
}

//COUNT RESPONSE LEVELS
public int CountResponseLevel(string level)
{
int count = 0;

for (int i = 0; i < incidents.Count; i++)
{
IEmergencyIncident incident =
(IEmergencyIncident)incidents[i];

if (incident.ResponseLevel == level)
{
count++
}
}
return count;
}

//COUNT INCICDENT TYPES
public int CountIncidentTypes(string type)
{
int count 0;

for (int i 0; i < incidents.Count; i++)
{
IEmergencyIncident =
(IEmergencyIncident)incidents[i];

if (incident.EmergencyType == type)
{
count++;
}
}

return count;
}
}

private void btnRegister_Click(object sender, EventArgs e)
{
// 1. Get information from the form
string id = txtIncidentID.Text.Trim();
string location = txtLocation.Text.Trim();

// 2. Validate the incident ID
if (id == "" || !id.StartsWith("INC") || id.Length <= 3)
{
MessageBox.Show("ID must start with INC, followed by numbers. Example: INC001");
return;
}

string numberPart = id.Substring(3);

for (int i = 0; i < numberPart.Length; i++)
{
if (!char.IsDigit(numberPart[i]))
{
MessageBox.Show("The incident ID must contain numbers after INC.");
return;
}
}

// 3. Check that the ID is unique
if (manager.FindIncident(id) != null)
{
MessageBox.Show("This incident ID already exists.");
return;
}

 // 4. Validate the location
 if (location == "")
 {
 MessageBox.Show("Please enter the incident location.");
 return;
  }

    // 5. Validate the emergency type
    if (cmbIncidentType.SelectedIndex == -1)
    {
        MessageBox.Show("Please select an emergency type.");
        return;
    }

    // 6. Validate people affected
    int people;

    if (!int.TryParse(txtPeopleAffected.Text, out people) || people <= 0)
    {
        MessageBox.Show("People affected must be a number greater than zero.");
        return;
    }

    // 7. Validate severity
    if (cmbSeverity.SelectedIndex == -1)
    {
        MessageBox.Show("Please select a severity level.");
        return;
    }

    int severity = cmbSeverity.SelectedIndex + 1;

    // 8. Validate response time
    int responseTime;

    if (!int.TryParse(txtResponseTime.Text, out responseTime) || responseTime <= 0)
    {
        MessageBox.Show("Response time must be greater than zero.");
        return;
}

// 9. Validate assigned units
int assignedUnits;

if (!int.TryParse(txtAssignedUnits.Text, out assignedUnits) || assignedUnits < 0)
{
MessageBox.Show("Assigned units cannot be negative.");
return;
}

// 10. Create the correct incident object
IEmergencyIncident incident;

if (cmbIncidentType.SelectedItem.ToString() == "Medical")
{
incident = new MedicalIncident(
id, location, people, severity, responseTime, assignedUnits);
}
else
{
incident = new FireIncident(
id, location, people, severity, responseTime, assignedUnits);
}

// 11. Add the incident to the manager
if (manager.AddIncident(incident))
{
MessageBox.Show("Incident registered successfully!");

// Display the calculated results
lblPriorityScore.Text = incident.PriorityScore.ToString("0.00");
lblResponseLevel.Text = incident.ResponseLevel;
lblResourceStatus.Text = incident.ResourceStatus;
lblAdditionalUnits.Text =
incident.AdditionalUnitsRequired.ToString();
RefreshIncidentList();
    }
}
